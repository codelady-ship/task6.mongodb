# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Put the real value in .env locally and in the Render dashboard. Never commit it.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/programmers?retryWrites=true&w=majority

# Optional: comma-separated browser origins allowed by CORS. Empty = all origins.
CORS_ORIGINS=https://task7-front-end-for-task6.vercel.app,http://localhost:3000

# Optional: Render sets PORT automatically.
PORT=8080
